# Copy to .env and edit when `just e2e-preflight` reports a collision with a
# subnet the host already uses. Compose reads .env automatically, and so do
# the harness scripts.
#
# The defaults mirror the real deployment: 192.168.178.0/24 on the ISP side
# and 10.10.10.0/24 as the downstream LAN. A host whose own LAN or DNS
# server lives in one of those has to move the lab out of the way.
#
# The derived addresses below (router WAN/LAN, client first address, the
# openwrt container, INT_PREFIX4) all default to a single consistent block.
# Moving a block means uncommenting *all* of its lines and keeping them
# consistent with the subnet, or Docker refuses the static addresses.

# --- downstream LAN ---------------------------------------------------
# One shared layer-2 segment: the router's LAN, its WAN (it comes back for
# its IPv4 default route as router-on-a-stick) and the 100 simulated hosts.
#E2E_LAN_SUBNET=10.10.30.0/24
#E2E_LAN_DOCKER_GATEWAY=10.10.30.254
#E2E_LAN_DOCKER_POOL=10.10.30.240/28
#E2E_OPENWRT_LAN_IP=10.10.30.2
#E2E_OPENWRT_LAN_CONTAINER_IP=10.10.30.4
#E2E_ROUTER_LAN_IP=10.10.30.1
#E2E_ROUTER_WAN_IP=10.10.30.5
#E2E_CLIENTS_CONTAINER_IP=10.10.30.10
#E2E_CLIENT_FIRST=10.10.30.11
#E2E_LAN_DHCP_START=10.10.30.200
#E2E_LAN_DHCP_END=10.10.30.239
#E2E_MACRELAY_INT_PREFIX4=10.10.30

# --- ISP LAN ---------------------------------------------------------
#E2E_ISP_SUBNET4=192.168.178.0/24
#E2E_ISP_DOCKER_GATEWAY=192.168.178.254
#E2E_ISP_DOCKER_POOL=192.168.178.240/28
#E2E_FRITZ_IP4=192.168.178.1
#E2E_OPENWRT_WAN_IP4=192.168.178.2
#E2E_OPENWRT_ISP_CONTAINER_IP=192.168.178.4
#E2E_ROUTER_MAPPED_IP=192.168.178.5
# The upstream /64 the hosts keep in passthrough mode.
#E2E_ISP_SUBNET6=2001:db8:f412::/64
#E2E_FRITZ_IP6=2001:db8:f412::1
#E2E_OPENWRT_WAN_IP6=2001:db8:f412::2

# The ISP /64 the hosts take their addresses from (passthrough), with the
# host octet in hex so their IPv4 and IPv6 identify each other.
#E2E_ISP_SUBNET6_PREFIX=2001:db8:f412

# --- harness ---------------------------------------------------------
#E2E_CONTROL_SUBNET=198.18.1.0/24
#E2E_CONTROL_GATEWAY=198.18.1.1
#E2E_CONTROL_IP=198.18.1.50
#E2E_OPENWRT_CONTROL_CONTAINER_IP=198.18.1.20

# --- scale -----------------------------------------------------------
#E2E_CLIENT_COUNT=100
#E2E_PROVISION_TIMEOUT=300

# --- MacRelay behaviour ----------------------------------------------
# The downstream LAN address MacRelay's RA advertises the shared /64 from.
#E2E_OPENWRT_LAN_IP6=2001:db8:f412::a
#E2E_MACRELAY_INT_PREFIX6=2001:db8:f412:
#E2E_MACRELAY_PROVISION_IPV6=1
#E2E_MACRELAY_PROXY_NDP=1
#E2E_MACRELAY_UNIFY_MAC=1
#E2E_MACRELAY_RESERVED_OCTETS="0 1 2 4 5 10 254 255"

# --- misc ------------------------------------------------------------
# Forward DNS here when Docker's embedded resolver has no working upstream.
#E2E_UPSTREAM_DNS=1.1.1.1
#E2E_VM_MEMORY=512
#E2E_VM_CPUS=2
#E2E_CONSOLE_PORT=2323
